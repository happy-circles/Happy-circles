+function rejectOversizedCollection(inst: $ZodType, payload: ParsePayload, leadingChecks: checks.$ZodCheck<never>[]): boolean {
+  const type = inst._zod.def.type;
+  const input = payload.value as any;
+  const size = type === "array" && Array.isArray(input) ? input.length
+    : (type === "set" && input instanceof Set) || (type === "map" && input instanceof Map) ? input.size : -1;
+  if (size < 0) return false;
+  for (const check of leadingChecks) {
+    const def = check._zod.def as any;
+    if (!/^(min_length|max_length|length_equals|min_size|max_size|size_equals)$/.test(def.check)) break;
+    const maximum = def.maximum ?? def.length ?? def.size;
+    if (size > maximum && (!def.when || def.when(payload))) {
+      const start = payload.issues.length;
+      check._zod.check(payload as any);
+      if (payload.issues.length > start) {
+        (payload.issues[start] as { continue?: boolean }).continue = false;
+        return true;
+      }
+    }
+  }
+  return false;
+}
