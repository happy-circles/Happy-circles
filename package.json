{
  "name": "happy-circles",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "preinstall": "node ./scripts/enforce-package-manager.mjs",
    "build": "pnpm -r build",
    "start": "pnpm dev:mobile",
    "start:clear": "pnpm dev:mobile:clear",
    "start:go": "pnpm dev:mobile:go",
    "start:go:clear": "pnpm dev:mobile:go:clear",
    "start:tunnel": "pnpm dev:mobile:tunnel",
    "start:tunnel:clear": "pnpm dev:mobile:tunnel:clear",
    "dev:mobile": "pnpm --dir apps/mobile run start",
    "dev:mobile:clear": "pnpm --dir apps/mobile run start:clear",
    "dev:mobile:go": "pnpm --dir apps/mobile run start:go",
    "dev:mobile:go:clear": "pnpm --dir apps/mobile run start:go:clear",
    "dev:mobile:tunnel": "pnpm --dir apps/mobile run start:tunnel",
    "dev:mobile:tunnel:clear": "pnpm --dir apps/mobile run start:tunnel:clear",
    "dev:landing": "pnpm --dir apps/landing run dev",
    "build:landing": "pnpm --dir apps/landing run build",
    "typecheck:landing": "pnpm --dir apps/landing run typecheck",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm audit --audit-level moderate && pnpm build:landing && pnpm security:check && pnpm test:supabase",
    "lint": "pnpm exec eslint .",
    "format": "pnpm exec prettier --write .",
    "security:check": "node ./scripts/security-check.mjs",
    "eas:push-credentials": "node --use-system-ca ./scripts/configure-eas-push-credentials.mjs",
    "supabase:cleanup:avatars": "node --use-system-ca ./scripts/cleanup-orphaned-avatars.mjs",
    "supabase:cron:graph-cycle": "node --use-system-ca ./scripts/update-graph-cycle-cron.mjs",
    "supabase:cron:push-notifications": "node --use-system-ca ./scripts/update-push-notification-cron.mjs",
    "supabase:usage": "node --use-system-ca ./scripts/supabase-usage-report.mjs",
    "test": "pnpm exec vitest run",
    "test:supabase": "node ./scripts/run-supabase-tests.mjs",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/node": "^22.10.2",
    "@types/react": "~19.1.10",
    "eslint": "^9.19.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.58.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom": "0.8.13",
      "esbuild": "0.25.0",
      "fast-uri": "3.1.2",
      "postcss": "8.5.12",
      "uuid": "14.0.0",
      "vite": "6.4.2"
    }
  }
}
